# Copy to .env and adjust. Every value below has a working default,
# so local development runs with no .env file at all.

# --- Backend (src/api.py) ---
# Extra browser origins allowed to call the API, comma-separated.
# localhost:5173 and 127.0.0.1:5173 are always allowed and do not need listing.
# Set this to your deployed dashboard URL when hosting.
# CORS_ALLOW_ORIGINS=https://your-dashboard.vercel.app

# Require an X-API-Key header on every data endpoint. Unset means open access,
# which is what the public demo uses (the CERT data is synthetic). Comma-
# separated "name:key" pairs, one per analyst -- the name is what lets the
# audit log attribute a lookup to a person instead of just an IP. Generate a
# key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# See SECURITY.md.
# API_KEYS=alice:REPLACE_ME,bob:REPLACE_ME

# Per-client rate limit. 0 disables limiting entirely.
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (dashboard/, read at build time by Vite) ---
# Base URL of the API. Defaults to http://localhost:8000 when unset.
# Must be prefixed with VITE_ to be exposed to the client bundle.
# VITE_API_BASE=https://your-api.onrender.com
